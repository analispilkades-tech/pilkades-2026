# Server-only Supabase credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
# SUPABASE_KEY is kept only as a legacy fallback.
# Do not expose either key to browser/public code.

SESSION_SECRET=replace-with-a-long-random-secret
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
GDRIVE_WEBHOOK_URL=https://YOUR-GDRIVE-WEBHOOK
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
