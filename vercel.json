{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" }
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 15,
      "includeFiles": [
        "node_modules/tesseract.js-core/*.wasm",
        "node_modules/tesseract.js-core/*.wasm.js"
      ]
    }
  }
}
