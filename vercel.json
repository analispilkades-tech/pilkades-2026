{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/superadmin",
      "destination": "/superadmin.html"
    }
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/tesseract.js-core/**"
    }
  }
}